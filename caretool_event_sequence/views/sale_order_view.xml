<odoo>
    <record id="action_event_sequence_config" model="ir.actions.act_window">
        <field name="name">Event Sequence Settings</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('code', 'in', ['sale.quotation.event', 'sale.order.event', 'account.invoice.event'])]
        </field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem name="Caretool Setting" id="main_menu_caretool_setting"
              parent="sale.menu_sale_config" sequence="35"/>

    <menuitem id="menu_event_sequence_config" name="Sequence Configuration"
              parent="caretool_event_sequence.main_menu_caretool_setting"
              action="action_event_sequence_config"/>
</odoo>

