<odoo>
    <data>
        <record id="seq_sale_quotation_event" model="ir.sequence">
            <field name="name">Quotation - Event</field>
            <field name="code">sale.quotation.event</field>
            <field name="prefix">EVQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_sale_order_event" model="ir.sequence">
            <field name="name">Sale Order - Event</field>
            <field name="code">sale.order.event</field>
            <field name="prefix">EVSO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_account_invoice_event" model="ir.sequence">
            <field name="name">Invoice - Event</field>
            <field name="code">account.invoice.event</field>
            <field name="prefix">EVINV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
